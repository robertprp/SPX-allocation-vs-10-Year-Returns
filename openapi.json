  "components": {
    "schemas": {
      "AllocationAnalysis": {
        "type": "object",
        "required": [
          "expected_returns",
          "extrapolated_returns",
          "last_updated_date",
          "last_extrapolated_date",
          "data"
        ],
        "properties": {
          "correlation_squared": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllocationPoint"
            }
          },
          "expected_returns": {
            "type": "number",
            "format": "double"
          },
          "extrapolated_returns": {
            "type": "number",
            "format": "double"
          },
          "last_extrapolated_date": {
            "type": "string",
            "format": "date-time"
          },
          "last_updated_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AllocationPoint": {
        "type": "object",
        "required": [
          "date"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Legacy allocation publication-date adjustment: add 90 days, then round up to month start."
          },
          "percentage": {
            "type": [
              "string",
              "null"
            ],
            "description": "Allocation ratio. Decimal string; for example \"0.25\" means 25%."
          },
          "return_10": {
            "type": [
              "string",
              "null"
            ],
            "description": "Realized forward ten-year annualized return. Null when future observations are unavailable."
          }
        }
      },
      "DatasetStatus": {
        "type": "object",
        "required": [
          "dataset",
          "rows"
        ],
        "properties": {
          "dataset": {
            "type": "string"
          },
          "latest_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Latest observation, not the time the scraper last ran. Null when empty."
          },
          "rows": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "RangeQuery": {
        "type": "object",
        "properties": {
          "from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Inclusive lower bound (UTC RFC 3339). Recession filters apply to start_date."
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Maximum rows, default 100, allowed 1..=1000. Results are oldest first."
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Rows to skip, default 0, allowed 0..=1000000."
          },
          "to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Inclusive upper bound (UTC RFC 3339)."
          }
        },
        "additionalProperties": false
      },
      "RecessionModel": {
        "type": "object",
        "required": [
          "start_date",
          "end_date"
        ],
        "properties": {
          "end_date": {
            "type": "string",
            "format": "date-time"
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SP500DailyModel": {
        "type": "object",
        "required": [
          "date",
          "value"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "SP500MonthlyModel": {
        "type": "object",
        "required": [
          "date"
        ],
        "properties": {
          "adjusted_close": {
            "type": [
              "string",
              "null"
            ]
          },
          "close": {
            "type": [
              "string",
              "null"
            ]
          },
          "cpi": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "dividend": {
            "type": [
              "string",
              "null"
            ]
          },
          "earnings": {
            "type": [
              "string",
              "null"
            ]
          },
          "gs10": {
            "type": [
              "string",
              "null"
            ]
          },
          "pe10": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "StockAssetAllocationModel": {
        "type": "object",
        "required": [
          "date",
          "percentage"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "percentage": {
            "type": "string"
          }
        }
      }
    }
  }
}
