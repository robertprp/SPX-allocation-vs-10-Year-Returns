{
  "openapi": "3.1.0",
  "info": {
    "title": "Financial Data API",
    "description": "Read-only financial time series and allocation analysis. All timestamps are UTC RFC 3339. Decimal financial values are JSON strings to preserve precision. Fractions represent ratios, not percentage points. Empty collections return 200 with []. Historical comparisons require sufficient ingested history; 503 means data or a dependency is unavailable. No authentication is configured; run locally or behind your own authenticated gateway.",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API server"
    }
  ],
  "paths": {
    "/api/v1/analysis/allocation-returns": {
      "get": {
        "tags": [
          "analysis"
        ],
        "summary": "Stock asset allocation versus realized forward ten-year S&P 500 returns.",
        "description": "Returns the complete available allocation history, including recent quarters. Each point\nis paired with the forward ten-year return beginning in the same month when available;\notherwise return_10 is null. The reference correlation sample filter applies only to\ncorrelation, never to either chart series. Dates have no publication offset.\nNo forecasts, daily-price extrapolation, or other return horizons are returned.",
        "operationId": "getAllocationReturnsAnalysis",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllocationAnalysis"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets": {
      "get": {
        "tags": [],
        "summary": "Inspect stored row counts and observation coverage. This is not a job-success log.",
        "operationId": "getDatasetCoverage",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DatasetStatus"
                  }
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recessions": {
      "get": {
        "tags": [],
        "operationId": "listRecessions",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "Inclusive lower bound (UTC RFC 3339). Recession filters apply to start_date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Inclusive upper bound (UTC RFC 3339).",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows, default 100, allowed 1..=1000. Results are oldest first.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 100,
              "maximum": 1000,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip, default 0, allowed 0..=1000000.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "maximum": 1000000,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecessionModel"
                  }
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
