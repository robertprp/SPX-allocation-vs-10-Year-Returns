{
  "openapi": "3.1.0",
  "info": {
    "title": "Financial Data API",
    "description": "Read-only financial time series and allocation analysis. All timestamps are UTC RFC 3339. Decimal financial values are JSON strings to preserve precision. Fractions represent ratios, not percentage points. Empty collections return 200 with []. Forecasts require sufficient ingested history; 503 means data or a dependency is unavailable. No authentication is configured; run locally or behind your own authenticated gateway.",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API server"
    }
  ],
  "paths": {
    "/api/v1/analysis/allocation-returns": {
      "get": {
        "tags": [
          "analysis"
        ],
        "summary": "Historical allocation regression, preserving the former GraphQL analysis.",
        "description": "Uses nonzero allocation/return pairs for ordinary least squares. Expected and extrapolated\nreturns are approximate numeric fractions (0.05 = 5%). Preserves the historical 90-day\npublication adjustment and price-ratio extrapolation. The SQL correlation view uses its own\npositive-return filter, so its squared correlation need not equal the regression R².\nRequires monthly history, allocations, daily observations and a nonconstant regression sample.",
        "operationId": "getAllocationReturnsAnalysis",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllocationAnalysis"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets": {
      "get": {
        "tags": [],
        "summary": "Inspect stored row counts and observation coverage. This is not a job-success log.",
        "operationId": "getDatasetCoverage",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DatasetStatus"
                  }
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recessions": {
      "get": {
        "tags": [],
        "operationId": "listRecessions",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "Inclusive lower bound (UTC RFC 3339). Recession filters apply to start_date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Inclusive upper bound (UTC RFC 3339).",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows, default 100, allowed 1..=1000. Results are oldest first.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 100,
              "maximum": 1000,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip, default 0, allowed 0..=1000000.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "maximum": 1000000,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecessionModel"
                  }
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
